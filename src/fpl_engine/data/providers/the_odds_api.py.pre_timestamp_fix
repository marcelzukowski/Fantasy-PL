PROVIDER = "the_odds_api"
DEFAULT_BASE_URL = "https://api.the-odds-api.com/v4"

DEFAULT_SPORT = "soccer_epl"

SUPPORTED_MARKETS = (
    "player_goal_scorer_anytime",
    "player_assists",
    "player_shots",
    "player_shots_on_target",
)

_MARKET_MAP = {
    "player_goal_scorer_anytime": MarketKind.ANYTIME_GOAL,
    "player_assists": MarketKind.ASSIST,
    "player_shots": MarketKind.SHOTS,
    "player_shots_on_target": MarketKind.SHOTS_ON_TARGET,
}

_SIDE_MAP = {
    "yes": MarketSide.YES,
    "no": MarketSide.NO,
    "over": MarketSide.OVER,
    "under": MarketSide.UNDER,
}


class TheOddsApiError(RuntimeError):
    """Base error for The Odds API integration."""


class TheOddsApiValidationError(TheOddsApiError):
    """Invalid adapter input or provider payload."""


class TheOddsApiRequestError(TheOddsApiError):
    """Network/transport failure."""


class TheOddsApiResponseError(TheOddsApiError):
    """Provider returned an unsuccessful response."""


class TheOddsApiQuotaExceededError(
    TheOddsApiResponseError
):
    """Provider quota/rate limit was reached."""


class TheOddsApiParseError(TheOddsApiError):
    """Provider payload cannot be safely interpreted."""


class TheOddsApiStorageError(TheOddsApiError):
    """RawStore or HttpCache failed."""


class TheOddsApiLeakageError(TheOddsApiError):
    """Historical response violates the PIT contract."""


def _utc(
    value: datetime,
    name: str,
) -> datetime:
    if (
        not isinstance(value, datetime)
        or value.tzinfo is None
        or value.utcoffset() is None
    ):
        raise TheOddsApiValidationError(
            f"{name} must be timezone-aware"
        )

    return value.astimezone(timezone.utc)


def _parse_datetime(
    value: object,
    name: str,
) -> datetime:
    if not isinstance(value, str):
        raise TheOddsApiParseError(
            f"{name} must be an ISO timestamp"
        )

    try:
        parsed = datetime.fromisoformat(
            value.replace("Z", "+00:00")
        )
    except ValueError as exc:
        raise TheOddsApiParseError(
            f"invalid {name}: {value!r}"
        ) from exc

    if (
        parsed.tzinfo is None
        or parsed.utcoffset() is None
    ):
        raise TheOddsApiParseError(
            f"{name} must be timezone-aware"
        )

    return parsed.astimezone(
        timezone.utc
    )


def _iso_z(
    value: datetime,
) -> str:
    return (
        _utc(value, "date")
        .isoformat()
        .replace("+00:00", "Z")
    )


def _non_empty(
    value: object,
    name: str,
) -> str:
    if not isinstance(value, str):
        raise TheOddsApiValidationError(
            f"{name} must be a non-empty string"
        )

    result = value.strip()

    if not result:
        raise TheOddsApiValidationError(
            f"{name} must be a non-empty string"
        )

    return result


def _json_value(
    body: bytes,
) -> Any:
    try:
        return json.loads(
            body.decode("utf-8")
        )
    except (
        UnicodeDecodeError,
        json.JSONDecodeError,
    ) as exc:
        raise TheOddsApiParseError(
            "provider returned invalid JSON"
        ) from exc


def _json_object(
    body: bytes,
) -> Mapping[str, Any]:
    payload = _json_value(
        body
    )

    if not isinstance(
        payload,
        dict,
    ):
        raise TheOddsApiParseError(
            "provider response must be a JSON object"
        )

    return payload


