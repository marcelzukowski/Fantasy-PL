@dataclass(frozen=True)
class TheOddsApiEvent:
    provider_event_id: str
    sport: str
    commence_time: datetime
    home_team: str
    away_team: str

    def __post_init__(self) -> None:
        object.__setattr__(
            self,
            "provider_event_id",
            _non_empty(
                self.provider_event_id,
                "provider_event_id",
            ),
        )

        object.__setattr__(
            self,
            "sport",
            _non_empty(
                self.sport,
                "sport",
            ),
        )

        object.__setattr__(
            self,
            "commence_time",
            _utc(
                self.commence_time,
                "commence_time",
            ),
        )

        object.__setattr__(
            self,
            "home_team",
            _non_empty(
                self.home_team,
                "home_team",
            ),
        )

        object.__setattr__(
            self,
            "away_team",
            _non_empty(
                self.away_team,
                "away_team",
            ),
        )

        if self.home_team == self.away_team:
            raise TheOddsApiValidationError(
                "home and away team must differ"
            )


